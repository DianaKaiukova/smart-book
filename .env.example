# Copy to .env and fill in. Everything except OPENAI_API_KEY has a working default for local dev.

# SQLite file (relative to the project root)
DATABASE_URL="file:./dev.db"

# Auth.js secret: generate with `npx auth secret` (required in production)
AUTH_SECRET=""

# AI assistant (OpenAI / ChatGPT)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Live occupancy layer
# sim = built-in simulator (demo), board = PSOC Edge E84 posts to /api/occupancy
OCCUPANCY_SOURCE="sim"
# Shared secret the board sends in the x-occupancy-key header (empty = open in dev)
OCCUPANCY_INGEST_KEY=""
SIM_TICK_SECONDS="2.5"

# Seed account passwords for `npm run db:seed`. Empty here on purpose — set real
# values in your .env (not committed). If unset, seeded accounts use a non-secret
# placeholder ("changeme") you should not rely on.
SEED_ADMIN_PASSWORD=""
SEED_MEMBER_PASSWORD=""
SEED_HOLDER_PASSWORD=""

# Ghost booking: minutes a booked room may stay empty after start before it is flagged
GHOST_AFTER_MINUTES="2"
# GHOST_AFTER_CHECKED_IN_MINUTES="4"
# NOISE_QUIET_BELOW_DB="45"
# NOISE_LOUD_FROM_DB="65"
# SIGNAL_STALE_AFTER_SECONDS="60"